{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_dangerous.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_env_guard.py"
          }
        ]
      },
      {
        "matcher": "Read|Glob|LS|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_env_guard.py"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_graphify_remind.py"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/graphify hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_tool_secrets.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_tool_lint.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/stop_story_lifecycle.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh"
  }
}