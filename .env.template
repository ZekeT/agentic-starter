# .env.template
# ============================================================
# Committed to git. Documents every environment variable the
# project needs. Copy to .env and fill in real values.
#
#   cp .env.template .env
#
# .env is gitignored — never commit it.
# .env.template should NEVER contain real secrets.
# ============================================================


# ---- Anthropic API ----------------------------------------
# Required when provider = "anthropic" in config/models.json
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# ---- Model provider override ------------------------------
# Only needed to point Claude Code at a non-Anthropic endpoint.
# Leave blank when using the Anthropic API directly.
# ANTHROPIC_API_URL=


# ---- Application ------------------------------------------
# Replace these with your project's actual variables.
# Group by concern: API keys, database, services, feature flags.

# Environment
APP_ENV=development        # development | staging | production

# Example: database
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Example: external API
# EXTERNAL_API_KEY=
# EXTERNAL_API_BASE_URL=https://api.example.com

# Example: feature flags
# FEATURE_NEW_UI=false


# ---- Notes ------------------------------------------------
# - Never put real values in this file.
# - Add a line here whenever you add a new env var to the project.
# - Document the purpose of each variable with a comment.
# - After adding a variable: update your .env, tell teammates to do the same.
