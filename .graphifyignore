# .graphifyignore — same syntax as .gitignore
# Files/dirs excluded from graphify knowledge graph builds.

# Dependencies and build artifacts
.venv/
venv/
dist/
build/
*.egg-info/
__pycache__/

# Test output (not useful in the graph)
.pytest_cache/
htmlcov/
coverage.xml

# Graphify's own output (avoid circular graphs)
graphify-out/

# Generated files
*.pyc
*.pyo
