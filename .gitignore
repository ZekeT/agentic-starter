.DS_Store
Thumbs.db

# Secrets (never commit these)
# .env.template is the ONLY .env file that should be committed.
.env
.env.local
.env.production
.env.staging
.env.development
.env.test
.env.secrets
.env.claude
*.pem
*.key

# Superpowers v6 SDD scratch files
.superpowers/

# OpenSpec-generated tool files — written by `openspec init` / `openspec update`,
# version-stamped by the CLI that wrote them. .harness/setup.sh generates them.
# NOTE: openspec/ itself (specs, changes, config.yaml) IS committed.
.claude/commands/opsx/
.claude/skills/openspec-*/
